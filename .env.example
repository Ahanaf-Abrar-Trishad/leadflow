DATABASE_URL=postgres://postgres:postgres@localhost:5432/outreach

# Generate each of these with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
UNSUBSCRIBE_SECRET=

# Optional. The worker/poller run in-process automatically once deployed
# (NODE_ENV=production) - see instrumentation.ts. Set to "true" to also run
# them under `next dev`, or "false" on every instance but one if this app is
# ever scaled to more than a single running process.
# OUTREACH_BACKGROUND_JOBS=

# Google Maps scraper engine (docker-compose's gmaps-scraper service).
# docker-compose sets this for the app container; this value is for `npm run dev`.
GMAPS_SCRAPER_URL=http://localhost:8080

# Public base URL of this app once deployed (e.g. https://app.youragency.com).
# Used for the Gmail OAuth redirect and, later, proposal and payment links.
# NEXT_PUBLIC_SITE_URL=

# Claude connector (MCP). Turns on /api/mcp/<token>, which Claude (Cowork,
# claude.ai or Claude Code) uses to draft icebreakers with your own Claude
# subscription. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MCP_ACCESS_TOKEN=

# Optional. How Claude should describe your agency when drafting.
# AGENCY_PITCH=a digital agency offering website design, local SEO and Google Ads management

# Optional. Your agency's name, shown on proposals ("from ...").
# AGENCY_NAME=

# Payments. With STRIPE_SECRET_KEY set, clients pay invoices by card or bank
# (ACH) through Stripe Checkout. Point a Stripe webhook at
# <NEXT_PUBLIC_SITE_URL>/api/stripe/webhook for the events
# checkout.session.completed, checkout.session.async_payment_succeeded and
# checkout.session.async_payment_failed, and put its signing secret here.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Shown on every pay page for wire, Zelle or check payments, which you then
# mark paid by hand. Plain text; use \n for new lines.
# PAYMENT_INSTRUCTIONS=

# Kickoff call booking link (Calendly or similar, https), added to the
# welcome email.
# KICKOFF_URL=
